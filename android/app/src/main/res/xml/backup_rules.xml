<?xml version="1.0" encoding="utf-8"?>
<!--
  No backups: OppoLink stores no user data that would survive reinstall.
  Identities and call history (if added later) should remain device-local.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
