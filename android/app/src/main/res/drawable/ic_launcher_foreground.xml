<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground. Five vertical bars echoing the OppoLink
  waveform logo, sized to sit inside the 72dp safe zone of a 108dp
  adaptive viewport (18..90 on both axes). Mirrors ic_notification at
  4.5x scale with bolder strokes so the icon reads on a launcher
  grid.

  The background is the dark slate (@color/ic_launcher_background)
  and the bars use the brand accent so the icon stays legible against
  the parallax mask the launcher applies on top.

  For Android 13+ themed icons, mipmap-anydpi-v26/ic_launcher.xml
  re-references this drawable as the monochrome layer. The system
  tints it according to the user's wallpaper, so the literal fill
  colour here only matters for the colour foreground path.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#3B82F6"
        android:pathData="M18,44h8v20h-8zM34,30h8v48h-8zM50,19h8v70h-8zM66,30h8v48h-8zM82,44h8v20h-8z" />
</vector>
